#toolbar {
    height: auto;
    align-vertical: middle;
}
#student-select {
    width: 1fr;
    margin: 0 1;
}
#progress {
    width: 100%;
    height: 1;
}
#filters {
    height: auto;
    padding: 1;
}
#filters > Button {
    margin-right: 2;
    padding: 0 3;
    min-width: 12;
    border: none;
    text-style: bold;
}
#filters > Button.filter.rating-correct {
    color: $success;
}
#filters > Button.filter.rating-partial {
    color: $warning;
}
#filters > Button.filter.rating-incorrect {
    color: $error;
}
#filters > Button.off {
    opacity: 0.3;
    text-style: none;
}
#content-horizontal {
    height: 1fr;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr;
}
#content-horizontal.narrow {
    grid-size: 1 2;
    grid-columns: 1fr;
    grid-rows: 1fr 1fr;
}
#content-horizontal > #criteria-scroll,
#content-horizontal > #preview-panel {
    width: 1fr;
    height: 1fr;
    margin: 0 1;
}
#content-horizontal.narrow > #criteria-scroll {
    border-right: none;
    border-bottom: solid $primary;
}
#preview-panel {
    border: round $primary;
    border-title-color: $primary;
}
#preview-panel > #preview-scroll {
    height: 1fr;
    width: 1fr;
}
#criteria-scroll {
    border-top: solid $primary;
    border-right: solid $primary;
}
#criteria-list {
    padding: 1 2;
}
.rating-incorrect {
    color: $error;
    text-style: bold;
}
.rating-partial {
    color: $warning;
    text-style: bold;
}
.rating-correct {
    color: $success;
    text-style: bold;
}
.rating-other {
    color: $text-muted;
}
