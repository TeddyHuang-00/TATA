/* SettingsScreen */
#settings-screen {
    height: 1fr;
    padding: 0 1;
}
#settings-top {
    height: 3;
    padding: 0 1;
}
#settings-title {
    height: 3;
    width: auto;
    padding: 0 1 0 0;
}
#ctx-select {
    height: 3;
    width: 52;
}
#ctx-hint {
    height: auto;
    padding: 0 0 1 0;
    color: $warning;
}
#settings-tabs {
    height: 1fr;
}
#settings-tabs > ContentSwitcher {
    height: 1fr;
}
#settings-tabs TabPane {
    height: 1fr;
    padding: 1 2;
}
#settings-tabs TabPane > ScrollableContainer {
    height: 1fr;
}
#canvas-env,
#canvas-fetch-list {
    height: auto;
    padding: 0 0 1 0;
}
#btn-test-canvas {
    width: auto;
    margin: 0 0 1 0;
}
/* Horizontal defaults to height:1fr; inside an overflowing ScrollableContainer
   1fr collapses to 1 row and clips the 3-row env buttons to a bare border
   strip (no label visible) — keep the container at its content height. */
#tab-canvas ScrollableContainer > Horizontal {
    height: auto;
}
#settings-actions {
    height: auto;
    padding: 1 0 0 0;
}
#settings-actions Button {
    margin: 0 1 0 0;
}
#settings-status {
    height: auto;
    padding: 0 1 1 1;
    border-top: solid $primary;
    color: $text-muted;
}
.settings-field {
    height: auto;
    padding: 0 0 1 0;
}
.settings-field Label {
    height: 1;
    color: $text-muted;
    text-style: bold;
}
.settings-field > Input,
.settings-field > Select,
.settings-field > Checkbox {
    height: 3;
    width: 1fr;
}
.field-heading {
    height: 1;
}
.field-heading Label {
    width: 1fr;
}
.field-heading Button {
    height: 1;
    width: 4;
    margin: 0 0 0 1;
    padding: 0;
}
#prompt-list {
    height: auto;
}
.prompt-row {
    height: auto;
}
.prompt-row Checkbox {
    height: auto;
    width: 1fr;
}
.prompt-row Button {
    height: auto;
    width: 3;
    margin: 0 0 0 1;
    padding: 0;
}
