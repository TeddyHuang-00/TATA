/* ===== TATA Workbench — platform shell (T4a) =====
   Theme: textual default dark (same as score_review.tcss — it defines no
   variables either); patterns lifted from design 99 §4. */

Screen {
    background: $surface;
}

/* ---- top bar + breadcrumb ---- */
#topbar {
    height: auto;
    padding: 0 1;
    border-bottom: solid $primary;
}

#breadcrumb {
    width: 1fr;  /* take the row minus the right-aligned #dash-actions */
    height: 3;  /* match the button row; text centred (buttons centre too) */
    content-align-vertical: middle;
    padding: 0 1;
    color: $text-muted;
}

#dash-head {
    height: auto;  /* Horizontal defaults to 1fr */
}

#dash-actions {
    width: auto;  /* hug the right edge inside #dash-head */
}

/* ---- dashboard table ---- */
#dashboard-table {
    height: 1fr;
    margin: 1 0 0 0;
    border: round $primary;
    border-title-color: $primary;
}

#dashboard-table > .datatable--header {
    text-style: bold;
    color: $primary;
}

/* ---- empty / status ---- */
#dash-empty {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    padding: 1 2;
    color: $text-muted;
}

#dash-status {
    height: auto;
    padding: 0 1;
    border-top: solid $primary;
    color: $text-muted;
}

/* ---- assignment workspace (T4b) ---- */
#workspace {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#ws-topbar {
    height: auto;
    padding: 0 1;
    border-bottom: solid $primary;
}

#ws-status {
    height: auto;
    padding: 0 1;  /* no bottom pad: #richlog needs every row it can get at 100x30 */
    color: $text-muted;
}

#ws-main {
    height: auto;
}

#stage-grid {
    grid-size: 2 3;
    grid-gutter: 0 2;  /* no row gap: the 1fr #richlog needs the 2 rows at 100x30 */
    width: 1fr;
    height: auto;
    margin: 0 1 0 0;  /* no top margin: the 1fr #richlog needs the rows at 100x30 */
}

.stage-btn {
    width: 1fr;
    height: 4;  /* 2 border rows + both label lines (subtitle was clipped at 3) */
    border: round $panel;
}

#config-panel {
    width: 38;
    height: auto;
    margin: 0;  /* aligned with #stage-grid (both start at #ws-main's top) */
    border: round $primary;
    border-title-color: $primary;
    padding: 0 1;
}

#config-body {
    height: auto;
    padding: 1 0;
}

#ws-progress {
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#ws-progress-text {
    width: auto;
}

#ws-progress > ProgressBar {
    width: 1fr;
    height: auto;
}

/* Textual's inner Bar defaults to width: 32 (widgets/_progress_bar.py) —
   stretch it across the whole track (v10 batch 2). */
#ws-progress > ProgressBar > Bar {
    width: 1fr;
}

#ws-cancel {
    width: auto;
    margin: 0 0 0 1;
}

#richlog {
    height: 1fr;
    border: round $primary;
    border-title-color: $text-muted;
}

#ws-empty {
    height: 1fr;
    content-align: center middle;
    padding: 1 2;
    color: $text-muted;
}

/* ---- tab shell ---- */
TabbedContent {
    height: 1fr;
}

/* ---- plagiarism workspace (S4; fullscreen push at course level) ----
   D9 panel framing: top bar / tabs area / log get round $primary borders.
   Horizontal/ContentSwitcher/TabPane default to 1fr/auto heights that leave
   the pane collapsed or the buttons row hogging the space; same scoped
   fr-chain fix as #settings-tabs / #library-tabs. */
#plag-topbar {
    height: auto;
    padding: 0 1;
    border: round $primary;
}

#plag-tabs {
    border: round $primary;
}

#plag-log {
    border: round $primary;
}

#plag-buttons,
#plag-progress {
    height: auto;
}

#plag-tabs > ContentSwitcher {
    height: 1fr;
}

#plag-tabs TabPane {
    height: 1fr;
}

/* ---- modal shell (used by later stages) ---- */
ModalScreen {
    background: $background 60%;
    align: center middle;
}

.confirm-modal {
    width: 92;
    max-width: 100%;  /* cap to the screen: 80-col terminals would clip width 92 */
    max-height: 36;
    height: auto;
    border: heavy $primary;
    background: $surface;
    padding: 1 2;
}

.confirm-modal Static {
    width: 1fr;
}

/* ---- alias editor modal ---- */
.alias-row {
    height: 3;
}

.alias-row Static {
    width: 24;
}

.alias-row Input {
    width: 1fr;
}
